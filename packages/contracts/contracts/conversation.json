{
  "module": "conversation",
  "authorityVersion": 1,
  "actor": {
    "table": "collaboration_actors",
    "idKey": "id",
    "tenantIdKey": "tenant_id",
    "kindKey": "kind",
    "kindValues": [
      "human",
      "agent",
      "service"
    ],
    "owningDomainKey": "owning_domain",
    "owningIdKey": "owning_id",
    "disabledAtKey": "disabled_at"
  },
  "conversation": {
    "table": "conversations",
    "idKey": "id",
    "tenantIdKey": "tenant_id",
    "titleKey": "title",
    "statusKey": "status",
    "statusValues": [
      "active",
      "archived"
    ],
    "subjectRefKey": "subject_ref",
    "createdByActorIdKey": "created_by_actor_id",
    "nextSequenceKey": "next_sequence",
    "legacySourceKey": "legacy_source",
    "legacyIdKey": "legacy_id",
    "createdAtKey": "created_at",
    "updatedAtKey": "updated_at"
  },
  "membership": {
    "table": "conversation_memberships",
    "idKey": "id",
    "tenantIdKey": "tenant_id",
    "conversationIdKey": "conversation_id",
    "actorIdKey": "actor_id",
    "roleKey": "role",
    "roleValues": [
      "reader",
      "writer",
      "admin"
    ],
    "statusKey": "status",
    "statusValues": [
      "active",
      "removed"
    ],
    "createdByActorIdKey": "created_by_actor_id",
    "createdAtKey": "created_at",
    "updatedAtKey": "updated_at"
  },
  "event": {
    "table": "conversation_events",
    "idKey": "id",
    "tenantIdKey": "tenant_id",
    "conversationIdKey": "conversation_id",
    "actorIdKey": "actor_id",
    "sequenceKey": "sequence",
    "idempotencyKey": "idempotency_key",
    "kindKey": "kind",
    "kindValues": [
      "message.created",
      "message.edited",
      "message.deleted",
      "membership.added",
      "membership.changed",
      "membership.removed"
    ],
    "payloadKey": "payload",
    "replyToEventIdKey": "reply_to_event_id",
    "targetEventIdKey": "target_event_id",
    "referencesKey": "references",
    "createdAtKey": "created_at",
    "cursor": {
      "field": "sequence",
      "mode": "exclusive"
    },
    "idempotency": {
      "scope": [
        "tenant_id",
        "conversation_id"
      ],
      "conflictStatus": 409
    },
    "immutable": true
  },
  "access": {
    "readRoles": [
      "reader",
      "writer",
      "admin"
    ],
    "writeRoles": [
      "writer",
      "admin"
    ],
    "adminRoles": [
      "admin"
    ],
    "denyByDefault": true
  },
  "authority": {
    "store": "shared_postgres",
    "actorDerivedServerSide": true,
    "runIsActor": false,
    "owningDomainReferences": [
      "agent_run",
      "proposal",
      "approval",
      "schedule",
      "meeting",
      "work_item",
      "canvas_document"
    ]
  },
  "thread": {
    "table": "chat_threads",
    "idKey": "id",
    "workspaceIdKey": "workspace_id",
    "teamIdKey": "team_id",
    "titleKey": "title",
    "statusKey": "status",
    "metadataKey": "metadata",
    "createdAtKey": "created_at",
    "updatedAtKey": "updated_at",
    "createdByKey": "created_by"
  },
  "message": {
    "table": "chat_messages",
    "idKey": "id",
    "threadIdKey": "thread_id",
    "roleKey": "role",
    "contentKey": "content",
    "partsKey": "parts",
    "metadataKey": "metadata",
    "toolInvocationsKey": "tool_invocations",
    "modelUsedKey": "model_used",
    "createdAtKey": "created_at"
  }
}
