+   */
+  visibility: ItemVisibility;
   readonly created_at: string;
   readonly updated_at: string;
 }
 
 /**
  * A check — the atom (§1, bottom of the object ladder). One action one person
- * takes, with the fixed three-state {@link CheckStatus} lifecycle. Lives under a
- * work item (its `work_item_id`).
+ * takes, with the fixed three-state {@link CheckStatus} lifecycle. Parents to a
+ * work item OR a project — at most one of the two; both `null` = unattached.
  */
 export interface Check {
   readonly id: string;
-  work_item_id: string;
+  /** The owning work item, or `null` when the check is not item-parented. */
+  work_item_id: string | null;
+  /** The owning project, or `null` when the check is not project-parented. */
+  project_id: string | null;
   title: string;
   /** Check status triad (§1 / §11) — never appears on work items. */
   status: CheckStatus;
@@ -939,6 +965,54 @@ export interface WorkItemDependency {
   readonly created_at: string;
 }
 
+/**
+ * A playbook — a reusable phase template for a project kind, optionally bound
+ * by {@link Project.playbook_ref}. `phases` is a free-form jsonb-style body;
+ * its concrete shape is enforced above this contract, never here.
+ */
+export interface Playbook {
+  readonly id: string;
+  /** The project kind this playbook applies to. */
+  kind: string;
+  name: string;
+  /** Free-form phase definition (jsonb); `{}` when none is authored yet. */
+  phases: Record<string, unknown>;
+  readonly created_at: string;
+  readonly updated_at: string;
+}
+
+/**
+ * The many-to-many link between a project and the teams contributing to it
+ * (the DESIGN `project_departments` junction, named `project_teams` after
+ * departments were promoted to teams). The `(project_id, team_id)` pair is
+ * unique; both FKs cascade on delete.
+ */
+export interface ProjectTeam {
+  readonly id: string;
+  project_id: string;
+  team_id: string;
+  readonly created_at: string;
+  readonly updated_at: string;
+}
+
+/**
+ * A stored server connection. Carries ONLY the reference to where the
+ * credential lives and who owns its scope — the credential VALUE (and any
+ * encrypted form of it) is deliberately never part of this contract.
+ */
+export interface Connection {
+  readonly id: string;
+  /** The user the connection belongs to (the creator for `user` scope). */
+  owner_user_id: string;
+  /** Whether the connection is personal (`user`) or shared (`workspace`). */
+  scope: ConnectionScope;
+  /** Opaque reference to the server/credential record — never a secret value. */
+  server_ref: string;
+  label: string;
+  readonly created_at: string;
+  readonly updated_at: string;
+}
+
 /**
