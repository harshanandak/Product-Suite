 export const WORK_ITEM_SOURCE_ORDER = ["manual", "meeting", "agent", "feedback"];
 
+/**
+ * Work-item / check visibility — who may read the object. `org` is the server
+ * default (every member of the tenant); `restricted` narrows reads to explicit
+ * `visibility_grants` rows plus the assignee. Values-only: no picker consumes
+ * labels/order yet.
+ */
+export const ITEM_VISIBILITY_VALUES = ["org", "restricted"];
+
+/**
+ * Connection credential scope — one user (`user`, the default) or the whole
+ * workspace. The credential VALUE itself is never part of this vocabulary or
+ * the `work-items.js` Connection contract.
+ */
+export const CONNECTION_SCOPE_VALUES = ["user", "workspace"];
+
 /**
  * Sentinel for the "Unassigned" owner option. Radix `Select` forbids
  * empty-string item values, so the picker carries this value and maps it
@@ -119,5 +134,7 @@ export const enums = {
     labels: WORK_ITEM_SOURCE_LABELS,
     order: WORK_ITEM_SOURCE_ORDER,
   },
+  itemVisibility: { values: ITEM_VISIBILITY_VALUES },
+  connectionScope: { values: CONNECTION_SCOPE_VALUES },
   assignee: { unassignedValue: ASSIGNEE_UNASSIGNED_VALUE },
 };
diff --git a/packages/contracts/src/enums.test.ts b/packages/contracts/src/enums.test.ts
index 3b38407..eceddec 100644
--- a/packages/contracts/src/enums.test.ts
+++ b/packages/contracts/src/enums.test.ts
@@ -52,6 +52,16 @@ const CASES: ReadonlyArray<{ key: string; unionType: string }> = [
   { key: "workItemSource", unionType: "WorkItemSource" },
 ];
 
+/**
+ * Values-only vocabularies — the same tri-directional check, minus the
+ * label/order invariant these deliberately do not carry yet (no picker
+ * consumes them).
+ */
+const VALUE_ONLY_CASES: ReadonlyArray<{ key: string; unionType: string }> = [
+  { key: "itemVisibility", unionType: "ItemVisibility" },
+  { key: "connectionScope", unionType: "ConnectionScope" },
+];
+
 describe("@product-suite/contracts enums — tri-directional sync", () => {
   test("the JS `enums` object deep-equals contracts/enums.json", () => {
     expect(enums).toEqual(enumsJson);
@@ -70,6 +80,28 @@ describe("@product-suite/contracts enums — tri-directional sync", () => {
     expect(sorted(tsMembers)).toEqual(sorted(jsonValues));
   });
 
+  test.each(VALUE_ONLY_CASES)(
+    "$key: JS values, .d.ts union, and JSON agree",
+    ({ key, unionType }) => {
+      const jsValues = enums[key as keyof typeof enums] as unknown as {
+        values: string[];
+      };
+      const jsonValues = enumsJson[key].values;
+      const tsMembers = unionMembers(unionType);
+
+      expect(sorted(jsValues.values)).toEqual(sorted(jsonValues));
+      expect(sorted(tsMembers)).toEqual(sorted(jsValues.values));
+      expect(sorted(tsMembers)).toEqual(sorted(jsonValues));
+    },
+  );
+
+  test("itemVisibility and connectionScope are exactly the F2 closed sets", () => {
+    expect(enumsModule.ITEM_VISIBILITY_VALUES).toEqual(["org", "restricted"]);
+    expect(unionMembers("ItemVisibility")).toEqual(["org", "restricted"]);
+    expect(enumsModule.CONNECTION_SCOPE_VALUES).toEqual(["user", "workspace"]);
+    expect(unionMembers("ConnectionScope")).toEqual(["user", "workspace"]);
+  });
+
   test.each(CASES)("$key: label keys and order cover exactly the value set", ({ key }) => {
     const descriptor = enumsJson[key];
     expect(sorted(Object.keys(descriptor.labels))).toEqual(sorted(descriptor.values));
@@ -91,6 +123,8 @@ describe("@product-suite/contracts enums — tri-directional sync", () => {
     expect(enumsModule.PRIORITY_ORDER).toEqual(enums.priority.order);
     expect(enumsModule.WORK_ITEM_TYPE_ORDER).toEqual(enums.workItemType.order);
     expect(enumsModule.WORK_ITEM_SOURCE_LABELS).toEqual(enums.workItemSource.labels);
+    expect(enumsModule.ITEM_VISIBILITY_VALUES).toEqual(enums.itemVisibility.values);
+    expect(enumsModule.CONNECTION_SCOPE_VALUES).toEqual(enums.connectionScope.values);
     expect(enumsModule.ASSIGNEE_UNASSIGNED_VALUE).toBe(enums.assignee.unassignedValue);
   });
 
