+type MeetingActionDestination = 'simple_task' | 'planned_work_item'
+type MeetingSummaryState = 'current' | 'dismissed'
+type MeetingActionState = 'pending' | 'added' | 'dismissed' | 'kept_as_follow_up'
+
+type MeetingCandidateSuggestion =
+  | { id: string; kind: 'owner'; position: 0 | 1 | 2; actor_id: string; label: string; href?: string }
+  | { id: string; kind: 'due_date'; position: 0 | 1 | 2; date: string; label: string }
+  | { id: string; kind: 'parent' | 'dependency'; position: 0 | 1 | 2; work_item_id: string; label: string; href: string }
+
+interface MeetingSummaryArtifactCardV1 {
+  schema_version: 1
+  id: string
