+  state: MeetingSummaryState
+  evidence_links: readonly { kind: 'decision' | 'follow_up'; id: string; label: string; href: string }[] // 0..3
+  links: {
+    meeting: { id: string; href: string }
+  }
+  actions: { adjust: boolean; dismiss: boolean } // no add key
+}
+
+interface MeetingActionCandidateCardV1 {
+  schema_version: 1
+  id: string
+  version: { id: string; number: number }
+  type: 'action_candidate'
+  destination: MeetingActionDestination
+  title: string
+  source_line: string
+  state: MeetingActionState
+  suggestions: readonly MeetingCandidateSuggestion[] // length 0..3
+  choices: readonly [
+    'Make this a simple task',
+    'Turn this into a planned work item',
+    'Keep this as a meeting follow-up',
+  ]
+  links: {
+    meeting: { id: string; href: string }
+    result?: { kind: 'work_item'; id: string; href: string }
+  }
