@@ -0,0 +1,33 @@
+import type { ShellState } from "./ipc.ts";
+
+export interface ShellViewModel {
+  readonly action: "authenticate" | "none" | "start";
+  readonly actionLabel: string;
+  readonly scope: string;
+  readonly status: string;
+}
+
+const VIEW_MODELS: Readonly<Record<ShellState, ShellViewModel>> = Object.freeze({
+  signed_out: Object.freeze({
+    action: "authenticate",
+    actionLabel: "Sign in",
+    scope: "No recording, upload, or local persistence is available in this shell.",
+    status: "Sign in to Product Suite to continue.",
+  }),
+  permission_required: Object.freeze({
+    action: "none",
+    actionLabel: "Permissions required",
+    scope: "Microphone and system-audio permission must be granted explicitly.",
+    status: "Capture permissions are required.",
+  }),
+  ready: Object.freeze({
+    action: "start",
+    actionLabel: "Start capture",
+    scope: "PR1 Task 1.1 is a secure shell only; it does not record or persist audio.",
+    status: "Signed in and permissions are ready.",
+  }),
+});
+
+export function viewModelFor(state: ShellState): ShellViewModel {
+  return VIEW_MODELS[state];
+}
diff --git a/apps/meeting-capture-desktop/tests/security-boundary.test.ts b/apps/meeting-capture-desktop/tests/security-boundary.test.ts
new file mode 100644
index 0000000..b464274
--- /dev/null
+++ b/apps/meeting-capture-desktop/tests/security-boundary.test.ts
@@ -0,0 +1,87 @@
+import { readFile } from "node:fs/promises";
+import { describe, expect, it } from "vitest";
+
+async function read(relativePath: string): Promise<string> {
+  return readFile(new URL(relativePath, new URL("../", import.meta.url)), "utf8");
+}
+
+async function readJson<T>(relativePath: string): Promise<T> {
+  return JSON.parse(await read(relativePath)) as T;
+}
+
+describe("desktop collector security boundary", () => {
+  it("exposes only the enumerated recorder, auth, and update commands", async () => {
+    const capability = await readJson<{ permissions: string[]; windows: string[] }>(
+      "src-tauri/capabilities/recorder.json",
+    );
+
+    expect(capability.windows).toEqual(["main"]);
+    expect(capability.permissions).toEqual([
+      "allow-get-collector-state",
+      "allow-begin-authentication",
+      "allow-start-capture",
+      "allow-check-for-update",
+    ]);
+    expect(capability.permissions.join(" ")).not.toMatch(/\*|shell|filesystem|fs:|process|http|clipboard|opener/i);
+  });
+
+  it("locks CSP to packaged assets and blocks remote navigation", async () => {
+    const config = await readJson<{ app: { security: { csp: string }; windows: Array<{ url?: string }> } }>(
+      "src-tauri/tauri.conf.json",
+    );
+    const csp = config.app.security.csp;
+
+    expect(csp).toContain("default-src 'self'");
+    expect(csp).toContain("script-src 'self'");
+    expect(csp).toContain("connect-src ipc: http://ipc.localhost");
+    expect(csp).toContain("object-src 'none'");
+    expect(csp).toContain("base-uri 'none'");
+    expect(csp).toContain("form-action 'none'");
+    expect(csp).toContain("frame-ancestors 'none'");
+    expect(csp).toContain("navigate-to 'none'");
+    expect(csp).not.toMatch(/unsafe-inline|unsafe-eval|https?:\/\/(?!ipc\.localhost)/);
+    expect(config.app.windows.every(({ url }) => url === undefined || !/^https?:/i.test(url))).toBe(true);
+  });
+
+  it("keeps frontend command inputs empty and network origins immutable", async () => {
+    const calls: Array<{ command: string; args: unknown }> = [];
+    const { createIpcClient } = await import("../src/ipc.ts");
+    const { PRODUCT_SUITE_ORIGINS } = await import("../src/origins.ts");
+    const client = createIpcClient(async (command, args) => {
+      calls.push({ command, args });
+      return command === "get_collector_state" ? "signed_out" : { ok: false };
+    });
+
+    await client.getCollectorState();
+    await client.beginAuthentication();
+    await client.startCapture();
+    await client.checkForUpdate();
+
+    expect(calls.map(({ command }) => command)).toEqual([
+      "get_collector_state",
+      "begin_authentication",
+      "start_capture",
+      "check_for_update",
+    ]);
+    expect(calls.every(({ args }) => args === undefined)).toBe(true);
+    expect(PRODUCT_SUITE_ORIGINS).toEqual({ api: null, updates: null, networkEnabled: false });
+    expect(Object.isFrozen(PRODUCT_SUITE_ORIGINS)).toBe(true);
+  });
+
+  it("has only exact dependencies and no generic OS or HTTP plugins", async () => {
+    const packageJson = await readJson<{
+      dependencies?: Record<string, string>;
+      devDependencies?: Record<string, string>;
+    }>("package.json");
+    const cargo = await read("src-tauri/Cargo.toml");
+    const allDependencies = { ...packageJson.dependencies, ...packageJson.devDependencies };
+
+    expect(allDependencies["@tauri-apps/api"]).toBe("2.11.1");
+    expect(allDependencies["@tauri-apps/cli"]).toBe("2.11.4");
+    expect(Object.values(allDependencies).every((version) => !/^[~^*]|\bx\b/i.test(version))).toBe(true);
+    expect(Object.keys(allDependencies).join(" ")).not.toMatch(/plugin-(shell|fs|process|http|clipboard|opener)/i);
+    expect(cargo).toContain('tauri = { version = "=2.11.5"');
+    expect(cargo).toContain('tauri-build = { version = "=2.6.3"');
+    expect(cargo).not.toMatch(/tauri-plugin-(shell|fs|process|http|clipboard|opener)/i);
+  });
+});
