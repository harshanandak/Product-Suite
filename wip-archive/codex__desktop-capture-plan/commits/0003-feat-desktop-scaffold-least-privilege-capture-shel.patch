+import { describe, expect, it } from "vitest";
+
+describe("foreground start authority", () => {
+  it("does not let a calendar suggestion invoke start_capture", async () => {
+    const calls: string[] = [];
+    const { createCollectorController } = await import("../src/controller.ts");
+    const controller = createCollectorController({
+      beginAuthentication: async () => ({ ok: false }),
+      checkForUpdate: async () => ({ ok: false }),
+      getCollectorState: async () => "signed_out",
+      startCapture: async () => {
+        calls.push("start_capture");
+        return { ok: false };
+      },
+    });
+
+    controller.setShellState("ready");
+    controller.applyCalendarSuggestion({ id: "opaque-event-1", label: "Suggested meeting" });
+    expect(calls).toEqual([]);
+    expect(controller.getView().suggestedAssociationId).toBe("opaque-event-1");
+
+    await controller.requestForegroundStart();
+    expect(calls).toEqual(["start_capture"]);
+  });
+
+  it("blocks start outside the ready state", async () => {
+    const calls: string[] = [];
+    const { createCollectorController } = await import("../src/controller.ts");
+    const controller = createCollectorController({
+      beginAuthentication: async () => ({ ok: false }),
+      checkForUpdate: async () => ({ ok: false }),
+      getCollectorState: async () => "signed_out",
+      startCapture: async () => {
+        calls.push("start_capture");
+        return { ok: false };
+      },
+    });
+
+    controller.setShellState("signed_out");
+    expect(await controller.requestForegroundStart()).toEqual({ ok: false, reason: "not_ready" });
+    controller.setShellState("permission_required");
+    expect(await controller.requestForegroundStart()).toEqual({ ok: false, reason: "not_ready" });
+    expect(calls).toEqual([]);
+  });
+});
