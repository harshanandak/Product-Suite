+import { describe, expect, it } from "vitest";
+import { createCollectorController } from "./controller.ts";
+
+describe("collector controller", () => {
+  it("rejects a URL-shaped calendar association without invoking capture", () => {
+    const controller = createCollectorController({
+      beginAuthentication: async () => ({ ok: false }),
+      checkForUpdate: async () => ({ ok: false }),
+      getCollectorState: async () => "signed_out",
+      startCapture: async () => ({ ok: false }),
+    });
+
+    controller.applyCalendarSuggestion({ id: "https://example.com/event", label: "Untrusted" });
+    expect(controller.getView().suggestedAssociationId).toBeNull();
+  });
+});
diff --git a/apps/meeting-capture-desktop/src/controller.ts b/apps/meeting-capture-desktop/src/controller.ts
new file mode 100644
index 0000000..25c1ab9
--- /dev/null
+++ b/apps/meeting-capture-desktop/src/controller.ts
@@ -0,0 +1,38 @@
+import type { CollectorIpc, CommandResult, ShellState } from "./ipc.ts";
+
+export interface CalendarSuggestion {
+  readonly id: string;
+  readonly label: string;
+}
+
+export interface CollectorView {
+  readonly state: ShellState;
+  readonly suggestedAssociationId: string | null;
+}
+
+const OPAQUE_ASSOCIATION_ID = /^[A-Za-z0-9_-]{1,128}$/;
+
+export function createCollectorController(ipc: CollectorIpc) {
+  let state: ShellState = "signed_out";
+  let suggestedAssociationId: string | null = null;
+
+  return Object.freeze({
+    setShellState(nextState: ShellState): void {
+      state = nextState;
+    },
+    applyCalendarSuggestion(suggestion: CalendarSuggestion): void {
+      if (OPAQUE_ASSOCIATION_ID.test(suggestion.id)) {
+        suggestedAssociationId = suggestion.id;
+      }
+    },
+    getView(): CollectorView {
+      return Object.freeze({ state, suggestedAssociationId });
+    },
+    async requestForegroundStart(): Promise<CommandResult & { readonly reason?: "not_ready" }> {
+      if (state !== "ready") {
+        return Object.freeze({ ok: false, reason: "not_ready" });
+      }
+      return ipc.startCapture();
+    },
+  });
+}
