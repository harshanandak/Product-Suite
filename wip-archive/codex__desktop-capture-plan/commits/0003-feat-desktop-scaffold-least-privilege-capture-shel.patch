diff --git a/apps/meeting-capture-desktop/src/ipc.ts b/apps/meeting-capture-desktop/src/ipc.ts
new file mode 100644
index 0000000..8cf0600
--- /dev/null
+++ b/apps/meeting-capture-desktop/src/ipc.ts
@@ -0,0 +1,37 @@
+import { invoke } from "@tauri-apps/api/core";
+
+export type ShellState = "signed_out" | "permission_required" | "ready";
+
+export interface CommandResult {
+  readonly ok: boolean;
+}
+
+export interface CollectorIpc {
+  getCollectorState(): Promise<ShellState>;
+  beginAuthentication(): Promise<CommandResult>;
+  startCapture(): Promise<CommandResult>;
+  checkForUpdate(): Promise<CommandResult>;
+}
+
+export type InvokeCommand = (command: string, args?: Record<string, never>) => Promise<unknown>;
+
+const invokeCommand: InvokeCommand = (command, args) => invoke(command, args);
+
+async function invokeBoolean(client: InvokeCommand, command: string): Promise<CommandResult> {
+  return Object.freeze({ ok: (await client(command)) === true });
+}
+
+export function createIpcClient(client: InvokeCommand = invokeCommand): CollectorIpc {
+  return Object.freeze({
+    async getCollectorState() {
+      const state = await client("get_collector_state");
+      if (state === "signed_out" || state === "permission_required" || state === "ready") {
+        return state;
+      }
+      return "signed_out";
+    },
+    beginAuthentication: () => invokeBoolean(client, "begin_authentication"),
+    startCapture: () => invokeBoolean(client, "start_capture"),
+    checkForUpdate: () => invokeBoolean(client, "check_for_update"),
+  });
+}
