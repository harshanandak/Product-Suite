diff --git a/apps/meeting-capture-desktop/src-tauri/src/security.rs b/apps/meeting-capture-desktop/src-tauri/src/security.rs
new file mode 100644
index 0000000..6a6e210
--- /dev/null
+++ b/apps/meeting-capture-desktop/src-tauri/src/security.rs
@@ -0,0 +1,21 @@
+#[derive(Debug, Eq, PartialEq)]
+pub struct ProductSuiteOrigins {
+    pub api: Option<&'static str>,
+    pub updates: Option<&'static str>,
+}
+
+pub const PRODUCT_SUITE_ORIGINS: ProductSuiteOrigins = ProductSuiteOrigins {
+    api: None,
+    updates: None,
+};
+
+pub fn is_allowed_navigation(url: &str) -> bool {
+    const LOCAL_ORIGINS: [&str; 2] = ["tauri://localhost", "http://tauri.localhost"];
+
+    LOCAL_ORIGINS.iter().any(|origin| {
+        url == *origin
+            || url
+                .strip_prefix(origin)
+                .is_some_and(|remainder| remainder.starts_with('/'))
+    })
+}
