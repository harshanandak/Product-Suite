index 0000000..d36a82c
--- /dev/null
+++ b/apps/meeting-capture-desktop/src-tauri/src/lib.rs
@@ -0,0 +1,21 @@
+mod commands;
+mod security;
+
+pub use security::{is_allowed_navigation, ProductSuiteOrigins, PRODUCT_SUITE_ORIGINS};
+
+pub fn run() {
+    let navigation_guard = tauri::plugin::Builder::new("navigation-guard")
+        .on_navigation(|_window, url| is_allowed_navigation(url.as_str()))
+        .build();
+
+    tauri::Builder::default()
+        .plugin(navigation_guard)
+        .invoke_handler(tauri::generate_handler![
+            commands::get_collector_state,
+            commands::begin_authentication,
+            commands::start_capture,
+            commands::check_for_update,
+        ])
+        .run(tauri::generate_context!())
+        .expect("meeting capture shell exited unexpectedly");
+}
