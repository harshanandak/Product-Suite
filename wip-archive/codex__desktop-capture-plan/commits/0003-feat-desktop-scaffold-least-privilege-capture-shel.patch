diff --git a/apps/meeting-capture-desktop/src-tauri/tests/security_boundary.rs b/apps/meeting-capture-desktop/src-tauri/tests/security_boundary.rs
new file mode 100644
index 0000000..d8366d6
--- /dev/null
+++ b/apps/meeting-capture-desktop/src-tauri/tests/security_boundary.rs
@@ -0,0 +1,12 @@
+use meeting_capture_desktop_lib::{is_allowed_navigation, PRODUCT_SUITE_ORIGINS};
+
+#[test]
+fn security_boundary() {
+    assert!(is_allowed_navigation("tauri://localhost"));
+    assert!(is_allowed_navigation("http://tauri.localhost"));
+    assert!(!is_allowed_navigation("https://example.com"));
+    assert!(!is_allowed_navigation("javascript:alert(1)"));
+    assert!(!is_allowed_navigation("file:///C:/secrets.txt"));
+    assert_eq!(PRODUCT_SUITE_ORIGINS.api, None);
+    assert_eq!(PRODUCT_SUITE_ORIGINS.updates, None);
+}
