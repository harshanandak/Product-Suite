@@ -0,0 +1,39 @@
+import { createCollectorController } from "./controller.ts";
+import { createIpcClient } from "./ipc.ts";
+import { viewModelFor } from "./view.ts";
+
+function requiredElement<T extends Element>(selector: string): T {
+  const element = document.querySelector<T>(selector);
+  if (!element) {
+    throw new Error(`collector shell is missing required local element: ${selector}`);
+  }
+  return element;
+}
+
+const statusCopy = requiredElement<HTMLParagraphElement>("#status-copy");
+const scopeCopy = requiredElement<HTMLParagraphElement>("#scope-copy");
+const primaryAction = requiredElement<HTMLButtonElement>("#primary-action");
+
+const ipc = createIpcClient();
+const controller = createCollectorController(ipc);
+
+function render(): void {
+  const model = viewModelFor(controller.getView().state);
+  statusCopy.textContent = model.status;
+  scopeCopy.textContent = model.scope;
+  primaryAction.textContent = model.actionLabel;
+  primaryAction.disabled = model.action === "none";
+  primaryAction.dataset.action = model.action;
+}
+
+primaryAction.addEventListener("click", async () => {
+  const action = primaryAction.dataset.action;
+  if (action === "authenticate") {
+    await ipc.beginAuthentication();
+  } else if (action === "start") {
+    await controller.requestForegroundStart();
+  }
+});
+
+controller.setShellState(await ipc.getCollectorState());
+render();
