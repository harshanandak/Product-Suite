From 3e1a312e9ff620deb7b81571372d61e8ec471561 Mon Sep 17 00:00:00 2001
From: Harsha Nanda <212836255+harshanandak@users.noreply.github.com>
Date: Sun, 20 Sep 2026 00:56:47 +0530
Subject: [PATCH] fix(ci): verify Meeting API dependency hashes

---
 .github/workflows/meeting-api-ci.yml          |    4 +-
 CHANGELOG.md                                  |    2 +-
 .../requirements-ci-cp313-linux-x86_64.txt    | 3363 +++++++++++++++++
 package.json                                  |    2 +-
 scripts/lock-meeting-api-ci.mjs               |   53 +
 test/lock-meeting-api-ci.test.js              |  130 +
 test/repo-tooling.test.js                     |   27 -
 7 files changed, 3550 insertions(+), 31 deletions(-)
 create mode 100644 apps/meeting-api/backend/requirements-ci-cp313-linux-x86_64.txt
 create mode 100644 scripts/lock-meeting-api-ci.mjs
 create mode 100644 test/lock-meeting-api-ci.test.js

diff --git a/.github/workflows/meeting-api-ci.yml b/.github/workflows/meeting-api-ci.yml
index e79452e..84ed5e2 100644
--- a/.github/workflows/meeting-api-ci.yml
+++ b/.github/workflows/meeting-api-ci.yml
@@ -68,8 +68,8 @@ jobs:
 
       - name: Install backend dependencies
         run: >-
-          python -m pip install --only-binary=:all:
-          -r apps/meeting-api/backend/requirements.txt
+          python -m pip install --only-binary=:all: --require-hashes
+          -r apps/meeting-api/backend/requirements-ci-cp313-linux-x86_64.txt
 
       - name: Run backend lint
         run: python -m flake8 --select=E9,F63,F7,F82 apps/meeting-api/backend apps/meeting-api/tests/backend
diff --git a/CHANGELOG.md b/CHANGELOG.md
index 993ef99..f8443a5 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -7,7 +7,7 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).
 ## [Unreleased]
 
 ### Security
-- Meeting API CI now installs exactly pinned backend dependencies from binary wheels without a mutable pip self-upgrade (PR #189, Forge issue `4ed8a31c-3f63-462d-84b2-9149090e69e0`)
+- Meeting API CI now installs a complete uv-generated, hash-verified CPython 3.13/Linux dependency lock from binary wheels without a mutable pip self-upgrade (PR #189, Forge issue `4ed8a31c-3f63-462d-84b2-9149090e69e0`)
 - Canonical tenant capability context now derives viewer/member/admin/owner authority from active database memberships and guards team, status, and project writes with fail-closed 404/403 behavior (PR #176, Forge issue `af872dc9-3c53-4f9d-9fc0-3e0bbdf6889f`)
 - GitHub Actions dependency installs for DB Contract and Platform Web now disable package lifecycle scripts while retaining frozen-lockfile enforcement (PR #171, Forge issue `808fbffa-8923-4083-9e5e-407b5b855454`)
 
diff --git a/apps/meeting-api/backend/requirements-ci-cp313-linux-x86_64.txt b/apps/meeting-api/backend/requirements-ci-cp313-linux-x86_64.txt
new file mode 100644
