+const CHART_BOUNDARY_EXTENSIONS = new Set([".js", ".jsx", ".mjs", ".ts", ".tsx", ".json", ".lock"]);
+const CHART_LEGACY_PATTERN = /recharts|\.recharts-|data-recharts|\.ts-chart|data-ts-/i;
+const TANSTACK_IMPORT_PATTERN = /(?:from\s*["']|import\s*["']|(?:import|require)\(\s*["'])@tanstack\/charts(?:["'/])/;
+const CHART_DEPENDENCY_SECTIONS = [
+  "dependencies",
+  "devDependencies",
+  "peerDependencies",
+  "optionalDependencies",
+];
+
+function chartLegacyFingerprint(source) {
+  const normalizedSource = source.replace(/\r\n?/g, "\n");
+  const matches = [...normalizedSource.matchAll(new RegExp(CHART_LEGACY_PATTERN.source, "gi"))];
+  const contexts = matches.map(({ 0: token, index }) => {
+    const start = Math.max(0, index - 80);
+    const end = Math.min(normalizedSource.length, index + token.length + 80);
+    return `${index}:${normalizedSource.slice(start, end)}`;
+  });
+  return createHash("sha256").update(contexts.join("\n")).digest("hex");
+}
+
+function listBoundaryFiles(directory, files = []) {
+  for (const entry of readdirSync(directory, { withFileTypes: true })) {
+    if ([".git", "node_modules", "dist", "coverage", "tmp"].includes(entry.name)) continue;
+    const entryPath = join(directory, entry.name);
+    if (entry.isDirectory()) {
+      listBoundaryFiles(entryPath, files);
+      continue;
+    }
+    const extension = entry.name.includes(".") ? `.${entry.name.split(".").pop()}` : "";
+    if (CHART_BOUNDARY_EXTENSIONS.has(extension) || entry.name === "bun.lock") files.push(entryPath);
+  }
+  return files;
+}
+
+function relativeBoundaryPath(root, filePath) {
+  return relative(root, filePath).replaceAll("\\", "/");
+}
+
+export function scanChartBoundary(root = rootDir) {
+  const legacyDebt = [];
+  const unlisted = [];
+  const tanstackOutsideEngine = [];
+  const floatingTanstackVersions = [];
+  let tanstackPackageVersion;
+  let tanstackLockVersion;
+
+  const files = root === rootDir
+    ? [join(root, "package.json"), join(root, "bun.lock")]
+        .concat(listBoundaryFiles(join(root, "apps")))
+        .concat(listBoundaryFiles(join(root, "packages")))
+    : listBoundaryFiles(root);
+
+  for (const filePath of files) {
+    const relativePath = relativeBoundaryPath(root, filePath);
+    const source = readFileSync(filePath, "utf8");
+
+    if (relativePath === "bun.lock") {
+      tanstackLockVersion = source.match(/"@tanstack\/charts@([^"\]]+)/)?.[1];
+    }
+
+    if (CHART_LEGACY_PATTERN.test(source)) {
+      if (
+        CHART_LEGACY_DEBT_ALLOWLIST.includes(relativePath) &&
+        CHART_LEGACY_DEBT_FINGERPRINTS[relativePath] === chartLegacyFingerprint(source)
+      ) {
+        legacyDebt.push(relativePath);
+      } else {
+        unlisted.push(relativePath);
+      }
+    }
+
+    if (TANSTACK_IMPORT_PATTERN.test(source) && !relativePath.startsWith("packages/ui-charting/src/engine/")) {
+      tanstackOutsideEngine.push(relativePath);
+    }
+
+    if (relativePath.endsWith("package.json")) {
+      try {
+        const manifest = JSON.parse(source);
+        for (const section of CHART_DEPENDENCY_SECTIONS) {
+          const version = manifest[section]?.["@tanstack/charts"];
+          if (version === undefined) continue;
+          if (relativePath === "packages/ui-charting/package.json" && section === "dependencies") {
+            tanstackPackageVersion = version;
+          }
+          if (relativePath !== "packages/ui-charting/package.json" || section !== "dependencies" || version !== "0.9.0") {
+            floatingTanstackVersions.push(`${relativePath}:${section}:${version}`);
+          }
+        }
+      } catch {
+        // Non-manifest JSON files are outside this dependency guard.
+      }
+    }
+  }
+
+  return {
+    legacyDebt: legacyDebt.sort(),
+    unlisted: unlisted.sort(),
+    tanstackOutsideEngine: tanstackOutsideEngine.sort(),
+    floatingTanstackVersions: floatingTanstackVersions.sort(),
+    tanstackPackageVersion,
+    tanstackLockVersion,
+  };
+}
