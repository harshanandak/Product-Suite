diff --git a/packages/ui-charting/src/chart-contract.js b/packages/ui-charting/src/chart-contract.js
new file mode 100644
index 0000000..09294c0
--- /dev/null
+++ b/packages/ui-charting/src/chart-contract.js
@@ -0,0 +1,78 @@
+export const CHART_KINDS = Object.freeze([
+  "time-series",
+  "categorical-bar",
+  "donut",
+  "radial-gauge",
+]);
+
+export const CHART_STATES = Object.freeze(["ready", "empty", "loading", "error"]);
+
+export const CHART_DATA_ATTRIBUTES = Object.freeze({
+  chart: "data-chart",
+  kind: "data-chart-kind",
+  state: "data-chart-state",
+  series: "data-chart-series",
+  tooltip: "data-chart-tooltip",
+});
+
+const DEFAULT_INITIAL_WIDTH = 320;
+
+function asFinitePositiveNumber(value) {
+  if (typeof value === "symbol") return undefined;
+  const number = Number(value);
+  return Number.isFinite(number) && number > 0 ? number : undefined;
+}
+
+function asNonEmptyString(value) {
+  return typeof value === "string" && value.trim() ? value.trim() : undefined;
+}
+
+function asFormatter(value) {
+  return typeof value === "function" ? value : undefined;
+}
+
+export function normalizeChartSeries(series = []) {
+  if (!Array.isArray(series)) return [];
+
+  return series
+    .map((entry) => {
+      const source = typeof entry === "string" ? { key: entry, label: entry } : entry;
+      const key = asNonEmptyString(source?.key);
+      if (!key) return null;
+
+      const normalized = {
+        key,
+        label: asNonEmptyString(source.label) ?? key,
+      };
+      const color = asNonEmptyString(source.color);
+      if (color) normalized.color = color;
+      const valueFormatter = asFormatter(source.valueFormatter);
+      if (valueFormatter) normalized.valueFormatter = valueFormatter;
+      return normalized;
+    })
+    .filter(Boolean);
+}
+
+export function normalizeChartDimensions(dimensions = {}) {
+  const source = dimensions && typeof dimensions === "object" ? dimensions : {};
+  return {
+    width: asFinitePositiveNumber(source.width),
+    height: asFinitePositiveNumber(source.height),
+    initialWidth: asFinitePositiveNumber(source.initialWidth) ?? DEFAULT_INITIAL_WIDTH,
+    aspectRatio: asFinitePositiveNumber(source.aspectRatio),
+    responsive: source.responsive !== false,
+  };
+}
+
+export function normalizeChartContract(contract = {}) {
+  const source = contract && typeof contract === "object" ? contract : {};
+  const kind = CHART_KINDS.includes(source.kind) ? source.kind : "time-series";
+  const normalized = {
+    kind,
+    rows: Array.isArray(source.rows) ? source.rows : [],
+    series: normalizeChartSeries(source.series),
+  };
+  const formatter = asFormatter(source.formatter);
+  if (formatter) normalized.formatter = formatter;
+  return normalized;
+}
diff --git a/packages/ui-charting/src/chart-contract.test.js b/packages/ui-charting/src/chart-contract.test.js
new file mode 100644
index 0000000..d8907bb
--- /dev/null
+++ b/packages/ui-charting/src/chart-contract.test.js
@@ -0,0 +1,121 @@
+import { describe, expect, test } from "bun:test";
+
+import {
+  CHART_DATA_ATTRIBUTES,
+  CHART_KINDS,
+  CHART_STATES,
+  normalizeChartContract,
+  normalizeChartDimensions,
+  normalizeChartSeries,
+} from "./chart-contract.js";
+import * as publicCharting from "./index.jsx";
+
+describe("ui-charting product contract", () => {
+  test("defines the finite chart families, states, and engine-neutral selectors", () => {
+    expect(CHART_KINDS).toEqual([
+      "time-series",
+      "categorical-bar",
+      "donut",
+      "radial-gauge",
+    ]);
+    expect(CHART_STATES).toEqual(["ready", "empty", "loading", "error"]);
+    expect(CHART_DATA_ATTRIBUTES).toEqual({
+      chart: "data-chart",
+      kind: "data-chart-kind",
+      state: "data-chart-state",
+      series: "data-chart-series",
+      tooltip: "data-chart-tooltip",
+    });
+  });
+
+  test("normalizes plain product rows and series metadata without engine fields", () => {
+    const rows = [{ date: "2026-08-10", completed: "4", leakedMark: { x: 1 } }];
+    const formatter = (value, context) => `${context.label}: ${value}`;
+    const series = [
+      {
+        key: "completed",
+        label: "Completed",
+        color: "var(--chart-1)",
+        valueFormatter: formatter,
+        mark: "lineY",
+      },
+    ];
+
+    expect(normalizeChartSeries(series)).toEqual([
+      { key: "completed", label: "Completed", color: "var(--chart-1)", valueFormatter: formatter },
+    ]);
+    expect(normalizeChartContract({ kind: "time-series", rows, series, formatter })).toEqual({
+      kind: "time-series",
+      rows,
+      series: [{ key: "completed", label: "Completed", color: "var(--chart-1)", valueFormatter: formatter }],
+      formatter,
+    });
+    expect(normalizeChartContract({ kind: "time-series", rows, series, formatter }).rows).toBe(rows);
+  });
+
+  test("normalizes responsive dimensions with a deterministic initial width", () => {
+    expect(
+      normalizeChartDimensions({ width: "480", height: 280, initialWidth: 360, aspectRatio: 1.5 }),
+    ).toEqual({
+      width: 480,
+      height: 280,
+      initialWidth: 360,
+      aspectRatio: 1.5,
+      responsive: true,
+    });
+    expect(normalizeChartDimensions()).toEqual({
+      width: undefined,
+      height: undefined,
+      initialWidth: 320,
+      aspectRatio: undefined,
+      responsive: true,
+    });
+  });
+
+  test("fails closed for malformed contracts and dimensions", () => {
+    const formatter = (value) => String(value);
+    const malformedContracts = [
+      [{ kind: "unsupported" }, { kind: "time-series", rows: [], series: [] }],
+      [{ rows: { name: "not-a-row" }, series: { key: "not-a-series" } }, { kind: "time-series", rows: [], series: [] }],
+      [{ formatter: "not-a-function", series: [{ key: "count", valueFormatter: "not-a-function" }] }, { kind: "time-series", rows: [], series: [{ key: "count", label: "count" }] }],
+    ];
+    for (const [input, expected] of malformedContracts) {
+      expect(normalizeChartContract(input)).toEqual(expected);
+    }
+
+    expect(normalizeChartDimensions({ width: 0, height: -1, initialWidth: Number.NaN, aspectRatio: Infinity })).toEqual({
+      width: undefined,
+      height: undefined,
+      initialWidth: 320,
+      aspectRatio: undefined,
+      responsive: true,
+    });
+    expect(normalizeChartSeries(null)).toEqual([]);
+    expect(normalizeChartSeries([null, {}, { key: "" }, { key: "valid", label: "Valid" }])).toEqual([
+      { key: "valid", label: "Valid" },
+    ]);
+    expect(formatter(4)).toBe("4");
+  });
+
+  test("rejects a top-level valueFormatter alias and preserves caller-owned input", () => {
+    const formatter = (value) => String(value);
+    const rows = [{ name: "Done", value: 4 }];
+    const series = [{ key: "value", label: "Value", valueFormatter: formatter }];
+    const input = { kind: "donut", rows, series, valueFormatter: formatter };
+    const snapshot = { ...input, rows: [...rows], series: series.map((item) => ({ ...item })) };
+
+    expect(normalizeChartContract(input)).toEqual({
+      kind: "donut",
+      rows,
+      series,
+    });
+    expect(input).toEqual(snapshot);
+  });
+
+  test("re-exports the product contract from the public package entrypoint", () => {
+    expect(publicCharting.normalizeChartContract).toBe(normalizeChartContract);
+    expect(publicCharting.normalizeChartDimensions).toBe(normalizeChartDimensions);
+    expect(publicCharting.normalizeChartSeries).toBe(normalizeChartSeries);
+    expect(publicCharting.CHART_DATA_ATTRIBUTES).toBe(CHART_DATA_ATTRIBUTES);
+  });
+});
