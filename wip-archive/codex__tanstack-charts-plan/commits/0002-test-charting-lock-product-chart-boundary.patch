 import type { ReactNode } from "react";
 
+export type ChartKind = "time-series" | "categorical-bar" | "donut" | "radial-gauge";
+export type ChartState = "ready" | "empty" | "loading" | "error";
+
+export interface ChartFormatterContext<Row = unknown> {
+  row: Row;
+  key?: string;
+  label?: string;
+}
+
+export type ChartValueFormatter<Row = unknown> = (
+  value: number,
+  context: ChartFormatterContext<Row>,
+) => string;
+
+export interface ChartSeries<Row = unknown> {
+  key: string;
+  label: string;
+  color?: string;
+  valueFormatter?: ChartValueFormatter<Row>;
+}
+
+export interface ChartDimensions {
+  width?: number | string;
+  height?: number | string;
+  initialWidth?: number | string;
+  aspectRatio?: number | string;
+  responsive?: boolean;
+}
+
+export interface NormalizedChartDimensions {
+  width?: number;
+  height?: number;
+  initialWidth: number;
+  aspectRatio?: number;
+  responsive: boolean;
+}
+
+export interface ChartContract<Row = unknown> {
+  kind: ChartKind;
+  rows: Row[];
+  series: ChartSeries<Row>[];
+  formatter?: ChartValueFormatter<Row>;
+}
+
+export const CHART_KINDS: readonly ChartKind[];
+export const CHART_STATES: readonly ChartState[];
+export const CHART_DATA_ATTRIBUTES: Readonly<{
+  chart: "data-chart";
+  kind: "data-chart-kind";
+  state: "data-chart-state";
+  series: "data-chart-series";
+  tooltip: "data-chart-tooltip";
+}>;
+
+export function normalizeChartSeries<Row = unknown>(
+  series?: readonly (ChartSeries<Row> | string)[],
+): ChartSeries<Row>[];
+export function normalizeChartDimensions(dimensions?: ChartDimensions): NormalizedChartDimensions;
+export function normalizeChartContract<Row = unknown>(
+  contract?: Partial<ChartContract<Row>>,
+): ChartContract<Row>;
+
