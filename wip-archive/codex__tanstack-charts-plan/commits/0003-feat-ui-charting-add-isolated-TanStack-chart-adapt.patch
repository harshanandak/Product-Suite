+import React, { Component, useId, useMemo } from "react";
+
+import {
+  CHART_KINDS,
+  CHART_STATES,
+  normalizeChartContract,
+  normalizeChartDimensions,
+} from "./chart-contract.js";
+import {
+  EngineChart,
+  exportTanStackPng,
+  exportTanStackSvg,
+} from "./engine/tanstack-charts.jsx";
+
+const DEFAULT_COPY = {
+  empty: "No chart data available.",
+  loading: "Loading chart…",
+  error: "Chart data failed to load.",
+};
+
+function finite(value) {
+  const number = Number(value);
+  return Number.isFinite(number) ? number : 0;
+}
+
+function stringValue(value) {
+  if (value instanceof Date) return value.toISOString();
+  return value == null ? "" : String(value);
+}
+
+function safeFormatter(formatter, value, context) {
+  try {
+    const result = formatter?.(finite(value), context);
+    return result == null ? String(finite(value)) : String(result);
+  } catch {
+    return String(finite(value));
+  }
+}
+
+function stableId(value, fallback) {
+  const text = String(value || fallback).toLowerCase().replace(/[^a-z0-9_-]+/g, "-").replace(/^-|-$/g, "");
+  return text || fallback;
+}
+
+function normalizedRows(rows) {
+  return Array.isArray(rows) ? rows : [];
+}
+
+function chartSeries(series, fallbackKey = "value") {
+  const values = Array.isArray(series) && series.length ? series : [{ key: fallbackKey, label: "Value" }];
+  return values.map((item) => (typeof item === "string" ? { key: item, label: item } : item));
+}
+
+function canonicalPlotModel({ kind, rows, series, xKey, categoryKey, valueKey, value, max }) {
+  const safeRows = normalizedRows(rows);
+  const safeSeries = chartSeries(series, valueKey || "value");
+
+  if (kind === "donut") {
+    const valueColumn = valueKey || safeSeries[0]?.key || "value";
+    return {
+      rows: safeRows.map((row) => ({
+        ...row,
+        [valueColumn]: Math.max(0, finite(row?.[valueColumn])),
+      })),
+      series: safeSeries,
+      value,
+      max,
+    };
+  }
+
+  if (kind === "radial-gauge") {
+    const canonicalMax = Math.max(0, finite(max ?? 100));
+    const canonicalValue = Math.min(canonicalMax, Math.max(0, finite(value)));
+    return { rows: safeRows.map((row) => ({ ...row })), series: safeSeries, value: canonicalValue, max: canonicalMax };
+  }
+
+  const xColumn = xKey || categoryKey || "name";
+  return {
+    rows: safeRows.map((row) => {
+      const normalized = { ...row };
+      for (const item of safeSeries) normalized[item.key] = finite(row?.[item.key]);
+      normalized[xColumn] = row?.[xColumn];
+      return normalized;
+    }),
+    series: safeSeries,
+    value,
+    max,
+  };
+}
+
+function tableModel({ kind, rows, series, xKey, categoryKey, valueKey, value, max, label }) {
+  if (kind === "radial-gauge") {
+    return {
+      headers: [label || "Value", "Maximum"],
+      rows: [[value, max]],
+      formatters: [undefined, undefined],
+      keys: ["value", "max"],
+    };
+  }
+
+  if (kind === "donut") {
+    const category = categoryKey || "name";
+    const valueColumn = valueKey || series?.[0]?.key || "value";
+    return {
+      headers: [category, series?.[0]?.label || valueColumn],
+      rows: normalizedRows(rows).map((row) => [row?.[category], finite(row?.[valueColumn])]),
+      formatters: [undefined, series?.[0]?.valueFormatter],
+      keys: [category, valueColumn],
+    };
+  }
+
+  const xColumn = xKey || categoryKey || "name";
+  const safeSeries = chartSeries(series);
+  return {
+    headers: [xColumn, ...safeSeries.map((item) => item.label || item.key)],
+    rows: normalizedRows(rows).map((row) => [row?.[xColumn], ...safeSeries.map((item) => finite(row?.[item.key]))]),
+    formatters: [undefined, ...safeSeries.map((item) => item.valueFormatter)],
+    keys: [xColumn, ...safeSeries.map((item) => item.key)],
+  };
+}
+
+function Table({ id, caption, model, rows }) {
+  return (
+    <table id={id} data-chart-table="true">
+      <caption>{caption}</caption>
+      <thead>
+        <tr>{model.headers.map((header) => <th key={header} scope="col">{header}</th>)}</tr>
+      </thead>
+      <tbody>
+        {model.rows.map((row, rowIndex) => (
+          <tr key={`${stringValue(row[0])}-${rowIndex}`}>
+            {row.map((cell, cellIndex) => {
+              const formatter = model.formatters[cellIndex];
+              const formatted = formatter
+                ? safeFormatter(formatter, cell, { row: rows[rowIndex], key: model.keys[cellIndex], label: model.headers[cellIndex] })
+                : stringValue(cell);
+              return <td key={`${model.keys[cellIndex]}-${rowIndex}`}>{formatted}</td>;
+            })}
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
+
+class ChartEngineBoundary extends Component {
+  constructor(props) {
+    super(props);
+    this.state = { failed: false };
+  }
+
+  static getDerivedStateFromError() {
+    return { failed: true };
+  }
+
+  componentDidCatch(error) {
+    this.props.onError?.(error);
+  }
+
+  render() {
+    return this.state.failed ? this.props.fallback : this.props.children;
+  }
+}
+
+function stateLabel(state) {
+  return DEFAULT_COPY[state] || "";
+}
+
+export function ChartFrame({
+  kind,
+  rows = [],
+  series = [],
+  state = "ready",
+  accessibility,
+  dimensions,
+  xKey,
+  categoryKey,
+  valueKey,
+  value,
+  max,
+  label,
+  orientation,
+  area = false,
+  points = true,
+  id,
+  engineFailure = false,
+  statusCopy,
+  children,
+  onEngineError,
+}) {
+  const safeKind = CHART_KINDS.includes(kind) ? kind : "time-series";
+  const contract = useMemo(() => normalizeChartContract({ kind: safeKind, rows, series }), [safeKind, rows, series]);
+  const canonical = useMemo(
+    () => canonicalPlotModel({ kind: safeKind, rows: contract.rows, series: contract.series, xKey, categoryKey, valueKey, value, max }),
+    [safeKind, contract.rows, contract.series, xKey, categoryKey, valueKey, value, max],
+  );
+  const safeRows = canonical.rows;
+  const safeSeries = canonical.series;
+  const safeDimensions = normalizeChartDimensions(dimensions);
+  const requestedState = CHART_STATES.includes(state) ? state : "ready";
+  const safeState = requestedState === "ready" && safeRows.length === 0 ? "empty" : requestedState;
+  const a11y = {
+    label: accessibility?.label || `${safeKind} chart`,
+    description: accessibility?.description,
+    summary: accessibility?.summary || "Exact chart values are shown in the table below.",
+    tableCaption: accessibility?.tableCaption || "Exact chart values",
+  };
+  const reactId = useId();
+  const idBase = stableId(id || reactId, `chart-${safeKind}`);
+  const summaryId = `${idBase}-summary`;
+  const descriptionId = a11y.description ? `${idBase}-description` : undefined;
+  const tableId = `${idBase}-table`;
+  const describedBy = [summaryId, descriptionId, tableId].filter(Boolean).join(" ");
+  const model = tableModel({ kind: safeKind, rows: safeRows, series: safeSeries, xKey, categoryKey, valueKey, value: canonical.value, max: canonical.max, label });
+  const canRenderEngine = safeState === "ready" && safeRows.length > 0;
+  const engineOptions = {
+    kind: safeKind,
+    rows: safeRows,
+    series: safeSeries,
+    xKey,
+    categoryKey,
+    valueKey,
+    value: canonical.value,
+    max: canonical.max,
+    orientation,
+    area,
+    points,
+    dimensions: safeDimensions,
+    accessibility: a11y,
+    describedBy,
+    forceEngineFailure: engineFailure,
+    onEngineError,
+  };
+  const engineFallback = <div data-chart-engine-error="true" role="status">Chart preview unavailable.</div>;
+
+  return (
+    <section
+      data-chart={safeKind}
+      data-chart-kind={safeKind}
+      data-chart-state={safeState}
+      data-chart-series={safeSeries.map((item) => item.key).join(" ") || undefined}
+      data-chart-tooltip="true"
+      data-chart-reduced-motion="true"
+      data-chart-orientation={orientation || undefined}
+      aria-label={a11y.label}
+      aria-describedby={describedBy}
+      style={{ height: safeDimensions.height || undefined, aspectRatio: safeDimensions.aspectRatio || undefined }}
+    >
+      <p id={summaryId} data-chart-summary="true">{a11y.summary}</p>
+      {a11y.description && <p id={descriptionId} data-chart-description="true">{a11y.description}</p>}
+      <div data-chart-surface="true" data-chart-engine={canRenderEngine ? "tanstack" : "none"}>
+        {canRenderEngine && (
+          <ChartEngineBoundary fallback={engineFallback} onError={onEngineError}>
+            <EngineChart options={engineOptions} />
+          </ChartEngineBoundary>
+        )}
+        {!canRenderEngine && <div data-chart-status="true" role={safeState === "error" ? "alert" : "status"}>{statusCopy || stateLabel(safeState)}</div>}
+        {children}
+      </div>
+      <Table id={tableId} caption={a11y.tableCaption} model={model} rows={safeRows} />
+    </section>
+  );
+}
+
+export function TimeSeriesChart(props) {
+  return <ChartFrame {...props} kind="time-series" xKey={props.xKey || "date"} />;
+}
+
+export function CategoricalBarChart(props) {
+  return <ChartFrame {...props} kind="categorical-bar" categoryKey={props.categoryKey || "name"} orientation={props.orientation || "vertical"} />;
+}
+
+export function DonutChart(props) {
+  return <ChartFrame {...props} kind="donut" categoryKey={props.categoryKey || "name"} valueKey={props.valueKey || "value"} />;
+}
+
+export function RadialGaugeChart(props) {
+  const gaugeRows = props.rows || [{ label: props.label || "Value", value: props.value }];
+  return <ChartFrame {...props} kind="radial-gauge" rows={gaugeRows} label={props.label || "Value"} />;
+}
+
+export function exportChartSvg(target, options) {
+  return exportTanStackSvg(target, options);
+}
+
+export function exportChartPng(target, options) {
+  return exportTanStackPng(target, options);
+}
+
+export const exportChartRaster = exportChartPng;
