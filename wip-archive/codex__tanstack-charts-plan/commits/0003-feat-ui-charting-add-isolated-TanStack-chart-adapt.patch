@@ -0,0 +1,270 @@
+import React, { useMemo } from "react";
+import {
+  areaY,
+  barX,
+  barY,
+  defineChart,
+  lineY,
+} from "@tanstack/charts";
+import { pie, polar, radialArc, radialText } from "@tanstack/charts/polar";
+import { Chart as TanStackChart } from "@tanstack/charts/react";
+import { renderChartImage, serializeChartSvg } from "@tanstack/charts/export";
+import { scaleBand } from "@tanstack/charts/scales/band";
+import { scaleLinear } from "@tanstack/charts/scales/linear";
+import { scalePoint } from "@tanstack/charts/scales/point";
+import { tooltip } from "@tanstack/charts/tooltip";
+
+const DEFAULT_HEIGHT = 280;
+const DEFAULT_COLOR = "#2563eb";
+const FALLBACK_COLORS = ["#2563eb", "#f97316", "#10b981", "#8b5cf6", "#e11d48"];
+
+function finite(value) {
+  const number = Number(value);
+  return Number.isFinite(number) ? number : 0;
+}
+
+function keyOf(value, index) {
+  const text = value == null ? "" : String(value);
+  return text || `row-${index}`;
+}
+
+function seriesRows(rows, series, xKey) {
+  return rows.map((row, index) => ({
+    ...row,
+    __x: row?.[xKey],
+    __y: finite(row?.[series.key]),
+    __key: `${series.key}-${keyOf(row?.[xKey], index)}-${index}`,
+    __series: series.key,
+  }));
+}
+
+function seriesColor(series, index) {
+  return series?.color || FALLBACK_COLORS[index % FALLBACK_COLORS.length] || DEFAULT_COLOR;
+}
+
+function tooltipRow(point, options) {
+  return point?.datum?.__row || point?.datum || options.rows[0];
+}
+
+function chartTooltip(options) {
+  const formatValue = (value, series, point) => {
+    try {
+      return series?.valueFormatter
+        ? series.valueFormatter(finite(value), { row: tooltipRow(point, options), key: series.key, label: series.label })
+        : String(finite(value));
+    } catch {
+      return String(finite(value));
+    }
+  };
+
+  return {
+    use: tooltip,
+    sticky: true,
+    visibility: "focus",
+    format(point) {
+      const series = options.series.find((item) => item.key === point?.datum?.__series) || options.series[0];
+      return `${series?.label || "Value"}: ${formatValue(point?.yValue ?? point?.datum?.__value, series, point)}`;
+    },
+    formatGroup(points) {
+      return points
+        .map((point) => {
+          const series = options.series.find((item) => item.key === point?.datum?.__series) || options.series[0];
+          return `${series?.label || "Value"}: ${formatValue(point?.yValue ?? point?.datum?.__value, series, point)}`;
+        })
+        .join("\n");
+    },
+  };
+}
+
+function cartesianDefinition(options) {
+  const rows = Array.isArray(options.rows) ? options.rows : [];
+  const series = options.series.length ? options.series : [{ key: "value", label: "Value" }];
+  const xKey = options.xKey || options.categoryKey || "name";
+  const marks = [];
+
+  for (const [index, item] of series.entries()) {
+    const source = seriesRows(rows, item, xKey);
+    const common = {
+      x: "__x",
+      y: "__y",
+      key: "__key",
+      fill: seriesColor(item, index),
+      stroke: seriesColor(item, index),
+      id: `${options.kind}-${item.key}`,
+      points: options.kind === "time-series" && options.points !== false,
+    };
+    if (options.kind === "time-series") {
+      marks.push(options.area ? areaY(source, { ...common, fillOpacity: 0.18 }) : lineY(source, common));
+    } else if (options.orientation === "horizontal") {
+      marks.push(barX(source, { x: "__y", y: "__x", key: "__key", fill: seriesColor(item, index), id: `${options.kind}-${item.key}`, inset: 2 }));
+    } else {
+      marks.push(barY(source, { x: "__x", y: "__y", key: "__key", fill: seriesColor(item, index), id: `${options.kind}-${item.key}`, inset: 2 }));
+    }
+  }
+
+  const horizontal = options.kind === "categorical-bar" && options.orientation === "horizontal";
+  return defineChart({
+    marks,
+    x: { scale: horizontal ? scaleLinear : options.kind === "categorical-bar" ? scaleBand : scalePoint },
+    y: { scale: horizontal ? scaleBand : scaleLinear },
+    tooltip: chartTooltip({ ...options, rows, series }),
+    keyboard: true,
+    pointer: true,
+    focus: "group-x",
+    svgAnimation: { duration: 180, respectReducedMotion: true, resize: false },
+  });
+}
+
+function donutDefinition(options) {
+  const categoryKey = options.categoryKey || "name";
+  const valueKey = options.valueKey || options.series?.[0]?.key || "value";
+  const source = (Array.isArray(options.rows) ? options.rows : []).map((row, index) => ({
+    ...row,
+    __id: keyOf(row?.[categoryKey], index),
+    __value: Math.max(0, finite(row?.[valueKey])),
+  }));
+  const ids = source.map((row) => row.__id);
+  const slices = pie(source, { value: "__value" });
+  return defineChart({
+    marks: [
+      polar({
+        inset: 8,
+        radiusRatio: 0.84,
+        marks: [
+          radialArc(slices, {
+            innerRadius: ({ radius }) => radius * 0.58,
+            cornerRadius: 4,
+            color: "__id",
+            key: "__id",
+          }),
+        ],
+      }),
+    ],
+    color: { domain: ids, range: options.series?.map((item, index) => seriesColor(item, index)) || FALLBACK_COLORS },
+    tooltip: chartTooltip({ ...options, rows: source, series: options.series || [{ key: valueKey, label: "Value" }] }),
+    keyboard: true,
+    pointer: true,
+    svgAnimation: { duration: 180, respectReducedMotion: true, resize: false },
+  });
+}
+
+function gaugeDefinition(options) {
+  const max = Math.max(0, finite(options.max ?? 100));
+  const value = Math.min(max, Math.max(0, finite(options.value)));
+  const source = [
+    { __id: "value", __value: value },
+    { __id: "remaining", __value: Math.max(0, max - value) },
+  ];
+  const slices = pie(source, { value: "__value", startAngle: -Math.PI * 0.75, endAngle: Math.PI * 0.75 });
+  return defineChart({
+    marks: [
+      polar({
+        radiusRatio: 0.84,
+        angle: { scale: scaleLinear().domain([0, 1]) },
+        radius: { scale: scaleLinear().domain([0, 1]) },
+        marks: [
+          radialArc(slices, {
+            innerRadius: ({ radius }) => radius * 0.72,
+            cornerRadius: 999,
+            color: "__id",
+            key: "__id",
+          }),
+          radialText([{ __id: "label", __value: value, __label: `${value}` }], {
+            angle: 0,
+            radius: 0,
+            text: "__label",
+            key: "__id",
+            fill: "currentColor",
+            fontSize: 20,
+            fontWeight: 700,
+          }),
+        ],
+      }),
+    ],
+    color: { domain: ["value", "remaining"], range: [options.color || DEFAULT_COLOR, "#e2e8f0"] },
+    tooltip: chartTooltip({ ...options, rows: source, series: [{ key: "__value", label: options.label || "Value" }] }),
+    keyboard: true,
+    pointer: true,
+    svgAnimation: { duration: 180, respectReducedMotion: true, resize: false },
+  });
+}
+
+export function createTanStackDefinition(options) {
+  if (options.forceEngineFailure) throw new Error("forced chart engine failure");
+  if (options.kind === "donut") return donutDefinition(options);
+  if (options.kind === "radial-gauge") return gaugeDefinition(options);
+  return cartesianDefinition(options);
+}
+
+export function EngineChart({ options }) {
+  const definition = useMemo(() => {
+    try {
+      return createTanStackDefinition(options);
+    } catch (error) {
+      options.onEngineError?.(error);
+      return null;
+    }
+  }, [
+    options.kind,
+    options.rows,
+    options.series,
+    options.xKey,
+    options.categoryKey,
+    options.valueKey,
+    options.value,
+    options.max,
+    options.orientation,
+    options.area,
+    options.points,
+    options.describedBy,
+    options.forceEngineFailure,
+    options.onEngineError,
+  ]);
+  const dimensions = options.dimensions || {};
+  const width = typeof dimensions.width === "number" ? dimensions.width : undefined;
+  const hasAspectRatio = typeof dimensions.aspectRatio === "number";
+  const height = typeof dimensions.height === "number" ? dimensions.height : hasAspectRatio ? undefined : DEFAULT_HEIGHT;
+  const initialWidth = typeof dimensions.initialWidth === "number" ? dimensions.initialWidth : 320;
+  const responsive = dimensions.responsive !== false;
+
+  if (!definition) return <div data-chart-engine-error="true" role="status">Chart preview unavailable.</div>;
+
+  try {
+    return (
+      <TanStackChart
+        definition={definition}
+        ariaLabel={options.accessibility.label}
+        ariaDescription={options.accessibility.description}
+        width={responsive ? width : width || initialWidth}
+        height={height}
+        aspectRatio={dimensions.aspectRatio}
+        initialWidth={initialWidth}
+        tabIndex={0}
+        className="ps-chart-engine"
+        onRender={({ svg }) => {
+          if (options.describedBy) svg.setAttribute("aria-describedby", options.describedBy);
+        }}
+      />
+    );
+  } catch (error) {
+    options.onEngineError?.(error);
+    return <div data-chart-engine-error="true" role="status">Chart preview unavailable.</div>;
+  }
+}
+
+export function exportTanStackSvg(target, options = {}) {
+  if (typeof target === "string") return target;
+  const element = target?.querySelector?.("svg") || target;
+  if (element?.outerHTML && !element.ownerDocument) return element.outerHTML;
+  if (!element || typeof element !== "object") throw new TypeError("A mounted chart element is required");
+  return serializeChartSvg(element, options);
+}
+
+export function exportTanStackPng(target, options = {}) {
+  const element = target?.querySelector?.("svg") || target;
+  if (!element || typeof element !== "object" || (!element.ownerDocument && typeof element.querySelector !== "function")) {
+    return Promise.reject(new TypeError("Browser canvas support is required for PNG export"));
+  }
+  const { _renderImage, ...exportOptions } = options;
+  return (_renderImage || renderChartImage)(element, { ...exportOptions, type: "image/png" });
+}
