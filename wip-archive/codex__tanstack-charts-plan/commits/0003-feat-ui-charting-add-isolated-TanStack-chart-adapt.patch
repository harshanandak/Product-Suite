+import { describe, expect, test } from "bun:test";
+
+import { createTanStackDefinition } from "./tanstack-charts.jsx";
+
+const rows = [
+  { category: "One", value: 2 },
+  { category: "Two", value: 4 },
+];
+
+describe("TanStack engine adapter", () => {
+  test("compiles every product family behind a private definition", () => {
+    const common = { rows, series: [{ key: "value", label: "Value" }] };
+    const definitions = [
+      createTanStackDefinition({ ...common, kind: "time-series", xKey: "category" }),
+      createTanStackDefinition({ ...common, kind: "categorical-bar", categoryKey: "category", orientation: "horizontal" }),
+      createTanStackDefinition({ ...common, kind: "categorical-bar", categoryKey: "category", orientation: "vertical" }),
+      createTanStackDefinition({ ...common, kind: "donut", categoryKey: "category", valueKey: "value" }),
+      createTanStackDefinition({ kind: "radial-gauge", value: 72, max: 100, series: [] }),
+    ];
+
+    for (const definition of definitions) {
+      expect(definition).toBeTruthy();
+      expect(definition.keyboard).toBe(true);
+      expect(definition.pointer).toBe(true);
+      expect(definition.svgAnimation).toMatchObject({ respectReducedMotion: true });
+    }
+  });
+});
