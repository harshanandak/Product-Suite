+import { describe, expect, test } from "bun:test";
+import React, { act } from "react";
+import { JSDOM } from "jsdom";
+import { createRoot } from "react-dom/client";
+import { renderToStaticMarkup } from "react-dom/server";
+
+import {
+  CategoricalBarChart,
+  ChartFrame,
+  DonutChart,
+  RadialGaugeChart,
+  TimeSeriesChart,
+  exportChartPng,
+  exportChartSvg,
+} from "./chart.jsx";
+import { createTanStackDefinition, EngineChart } from "./engine/tanstack-charts.jsx";
+
+const accessibility = {
+  label: "Work completed over time",
+  description: "Completed work for the selected period.",
+  summary: "Completed work rose from 2 to 4.",
+  tableCaption: "Exact completed work by day",
+};
+
+const timeRows = [
+  { day: "Mon", completed: 2 },
+  { day: "Tue", completed: 4 },
+];
+
+const series = [{ key: "completed", label: "Completed", color: "#2563eb" }];
+
+function render(element) {
+  return renderToStaticMarkup(element);
+}
+
+async function withDom(run) {
+  const dom = new JSDOM("<!doctype html><html><body></body></html>", { pretendToBeVisual: true });
+  const previous = {
+    window: globalThis.window,
+    document: globalThis.document,
+    navigator: globalThis.navigator,
+    ResizeObserver: globalThis.ResizeObserver,
+    HTMLElement: globalThis.HTMLElement,
+    SVGSVGElement: globalThis.SVGSVGElement,
+    IS_REACT_ACT_ENVIRONMENT: globalThis.IS_REACT_ACT_ENVIRONMENT,
+  };
+  const observers = [];
+  class TestResizeObserver {
+    constructor(callback) {
+      this.callback = callback;
+      this.disconnected = false;
+      this.target = null;
+      observers.push(this);
+    }
+
+    observe(target) {
+      this.target = target;
+    }
+
+    disconnect() {
+      this.disconnected = true;
+    }
+
+    trigger() {
+      this.callback([{ target: this.target }]);
+    }
+  }
+
+  globalThis.window = dom.window;
+  globalThis.document = dom.window.document;
+  globalThis.navigator = dom.window.navigator;
+  globalThis.HTMLElement = dom.window.HTMLElement;
+  globalThis.SVGSVGElement = dom.window.SVGSVGElement;
+  dom.window.SVGSVGElement.prototype.getBoundingClientRect = () => ({
+    width: 360,
+    height: 220,
+    top: 0,
+    left: 0,
+    right: 360,
+    bottom: 220,
+  });
+  globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+  globalThis.ResizeObserver = TestResizeObserver;
+  dom.window.ResizeObserver = TestResizeObserver;
+  dom.window.requestAnimationFrame = (callback) => {
+    callback(0);
+    return 0;
+  };
+  dom.window.cancelAnimationFrame = () => {};
+
+  try {
+    return await run(dom.window, observers);
+  } finally {
+    globalThis.window = previous.window;
+    globalThis.document = previous.document;
+    globalThis.navigator = previous.navigator;
+    globalThis.ResizeObserver = previous.ResizeObserver;
+    globalThis.HTMLElement = previous.HTMLElement;
+    globalThis.SVGSVGElement = previous.SVGSVGElement;
+    globalThis.IS_REACT_ACT_ENVIRONMENT = previous.IS_REACT_ACT_ENVIRONMENT;
+    dom.window.close();
+  }
+}
+
+describe("shared TanStack chart adapter", () => {
+  test("renders a ready time-series as SVG with product selectors and exact table linkage", () => {
+    const html = render(
+      <TimeSeriesChart
+        rows={timeRows}
+        xKey="day"
+        series={series}
+        accessibility={accessibility}
+        state="ready"
+        dimensions={{ initialWidth: 360, height: 240 }}
+      />,
+    );
+
+    expect(html).toContain('data-chart="time-series"');
+    expect(html).toContain('data-chart-kind="time-series"');
+    expect(html).toContain('data-chart-state="ready"');
+    expect(html).toContain('data-chart-series="completed"');
+    expect(html).toContain("<svg");
+    expect(html).toContain('aria-label="Work completed over time"');
+    expect(html).toContain("Completed work rose from 2 to 4.");
+    expect(html).toContain('data-chart-summary="true"');
+    expect(html).toContain('data-chart-table="true"');
+    expect(html).toContain("Exact completed work by day");
+    expect(html).toContain("Mon");
+    expect(html).toContain("Tue");
+    expect(html).toContain("2");
+    expect(html).toContain("4");
+    expect(html).toMatch(/aria-describedby="[^"]+ [^"]+"/);
+    const describedBy = html.match(/aria-describedby="([^"]+)"/)?.[1]?.split(" ") || [];
+    expect(describedBy).toHaveLength(3);
+    expect(html).toContain(`id="${describedBy[1]}"`);
+  });
+
+  test("maps both categorical bar orientations, donut, and radial gauge to SVG scenes", () => {
+    const common = {
+      accessibility,
+      state: "ready",
+      dimensions: { initialWidth: 320, height: 200 },
+    };
+    const bars = [
+      { category: "One", amount: 3 },
+      { category: "Two", amount: 7 },
+    ];
+    const horizontal = render(
+      <CategoricalBarChart
+        {...common}
+        rows={bars}
+        categoryKey="category"
+        series={[{ key: "amount", label: "Amount" }]}
+        orientation="horizontal"
+      />,
+    );
+    const vertical = render(
+      <CategoricalBarChart
+        {...common}
+        rows={bars}
+        categoryKey="category"
+        series={[{ key: "amount", label: "Amount" }]}
+        orientation="vertical"
+      />,
+    );
+    const donut = render(
+      <DonutChart
+        {...common}
+        rows={bars}
+        categoryKey="category"
+        valueKey="amount"
+      />,
+    );
+    const radial = render(
+      <RadialGaugeChart
+        {...common}
+        value={72}
+        max={100}
+        label="Coverage"
+      />,
+    );
+
+    for (const html of [horizontal, vertical, donut, radial]) {
+      expect(html).toContain("<svg");
+      expect(html).not.toContain("<canvas");
+      expect(html).toContain('data-chart-state="ready"');
+      expect(html).toContain('data-chart-table="true"');
+    }
+    expect(horizontal).toContain('data-chart="categorical-bar"');
+    expect(vertical).toContain('data-chart="categorical-bar"');
+    expect(horizontal).toContain('data-chart-orientation="horizontal"');
+    expect(vertical).toContain('data-chart-orientation="vertical"');
+    expect(donut).toContain('data-chart="donut"');
+    expect(radial).toContain('data-chart="radial-gauge"');
+  });
+
+  test("keeps summary and exact-value table for every non-ready state", () => {
+    for (const state of ["empty", "loading", "error"]) {
+      const html = render(
+        <ChartFrame
+          kind="time-series"
+          state={state}
+          rows={timeRows}
+          series={series}
+          xKey="day"
+          accessibility={accessibility}
+          dimensions={{ initialWidth: 320 }}
+        />,
+      );
+      expect(html).toContain(`data-chart-state="${state}"`);
+      expect(html).toContain("Completed work rose from 2 to 4.");
+      expect(html).toContain('data-chart-table="true"');
+      expect(html).not.toContain("<svg");
+    }
+  });
+
+  test("exports product-owned SVG and raster wrappers without exposing engine types", async () => {
+    expect(typeof exportChartSvg).toBe("function");
+    expect(typeof exportChartPng).toBe("function");
+    expect(exportChartSvg({ outerHTML: "<svg/>" })).toBe("<svg/>");
+    await expect(exportChartPng({})).rejects.toThrow(/browser|canvas|PNG/i);
+  });
+
+  test("exports mounted SVG dimensions and a PNG through the product seam", async () => {
+    await withDom(async (window) => {
+      const container = window.document.createElement("div");
+      window.document.body.append(container);
+      const root = createRoot(container);
+      await act(async () => {
+        root.render(
+          <TimeSeriesChart
+            rows={timeRows}
+            xKey="day"
+            series={series}
+            accessibility={accessibility}
+            dimensions={{ initialWidth: 360, height: 220, responsive: false }}
+          />,
+        );
+      });
+
+      const svg = exportChartSvg(container, { width: 480, height: 240 });
+      expect(svg).toContain("<svg");
+      expect(svg).toContain('aria-label="Work completed over time"');
+      expect(svg).toMatch(/(?:width="480"|viewBox="0 0 480 240")/);
+
+      const png = await exportChartPng(container, {
+        _renderImage: (element, options) => ({ element, options, type: "image/png" }),
+      });
+      expect(png.type).toBe("image/png");
+      expect(png.options.type).toBe("image/png");
+      expect(png.element).toBe(container.querySelector("svg"));
+
+      await act(async () => root.unmount());
+    });
+  });
+
+  test("normalizes exact values and formatting from one plotted data source", () => {
+    const html = render(
+      <TimeSeriesChart
+        rows={[{ day: "Mon", completed: "2.5" }, { day: "Tue", completed: Number.NaN }]}
+        xKey="day"
+        series={[{
+          key: "completed",
+          label: "Completed",
+          valueFormatter: (value) => `${value.toFixed(1)} items`,
+        }]}
+        accessibility={{ ...accessibility, summary: "Exact values are listed below." }}
+        state="ready"
+      />,
+    );
+
+    expect(html).toContain("2.5 items");
+    expect(html).toContain("0.0 items");
+    expect(html).toContain("Exact values are listed below.");
+  });
+
+  test("shares clamped donut and gauge values between the rendered scene and exact table", () => {
+    const donut = render(
+      <DonutChart
+        rows={[{ category: "Negative", amount: -4 }, { category: "Positive", amount: 4 }]}
+        categoryKey="category"
+        valueKey="amount"
+        series={[{ key: "amount", label: "Amount" }]}
+        accessibility={accessibility}
+      />,
+    );
+    expect(donut).toContain("<svg");
+    expect(donut).toMatch(/<td>Negative<\/td><td>0<\/td>/);
+    expect(donut).toMatch(/<td>Positive<\/td><td>4<\/td>/);
+
+    const below = render(<RadialGaugeChart value={-20} max={100} label="Coverage" accessibility={accessibility} />);
+    const above = render(<RadialGaugeChart value={120} max={100} label="Coverage" accessibility={accessibility} />);
+    expect(below).toMatch(/<td>0<\/td><td>100<\/td>/);
+    expect(above).toMatch(/<td>100<\/td><td>100<\/td>/);
+    expect(below).toContain('data-chart-state="ready"');
+    expect(above).toContain('data-chart-state="ready"');
+  });
+
+  test("preserves summary and exact table when ChartFrame engine rendering fails", () => {
+    const html = render(
+      <ChartFrame
+        kind="time-series"
+        rows={timeRows}
+        xKey="day"
+        series={series}
+        accessibility={accessibility}
+        engineFailure
+      />,
+    );
+    expect(html).toContain('data-chart-engine-error="true"');
+    expect(html).toContain("Completed work rose from 2 to 4.");
+    expect(html).toContain('data-chart-table="true"');
+    expect(html).toContain("Mon");
+    expect(html).toContain("4");
+  });
+
+  test("keeps sibling chart identities unique while preserving deterministic SSR", () => {
+    const props = { rows: timeRows, xKey: "day", series, accessibility };
+    const html = render(
+      <div>
+        <TimeSeriesChart {...props} />
+        <TimeSeriesChart {...props} />
+      </div>,
+    );
+    const ids = [...html.matchAll(/<p id="([^"]+)" data-chart-summary="true"/g)].map((match) => match[1]);
+    expect(ids).toHaveLength(2);
+    expect(new Set(ids).size).toBe(2);
+    expect(render(<TimeSeriesChart {...props} />)).toBe(render(<TimeSeriesChart {...props} />));
+  });
+
+  test("keeps responsive SSR deterministic and treats ready empty input as empty", () => {
+    const props = {
+      rows: timeRows,
+      xKey: "day",
