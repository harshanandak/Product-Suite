 apps/platform-web/src/test/setup.ts | 35 +++++++++++++++++++++++++++++
 apps/platform-web/vitest.config.ts  |  2 +-
 bun.lock                            |  9 +++++---
 4 files changed, 43 insertions(+), 4 deletions(-)

diff --git a/apps/platform-web/package.json b/apps/platform-web/package.json
index 4607c43..b0b9842 100644
--- a/apps/platform-web/package.json
+++ b/apps/platform-web/package.json
@@ -56,6 +56,7 @@
     "eslint-plugin-react-hooks": "^5.2.0",
     "eslint-plugin-react-refresh": "^0.4.20",
     "globals": "15.15.0",
+    "happy-dom": "^20.10.6",
     "jsdom": "^25.0.1",
     "react-doctor": "^0.5.8",
     "react-grab": "^0.1.47",
diff --git a/apps/platform-web/src/test/setup.ts b/apps/platform-web/src/test/setup.ts
index 6d8c14d..0f46ca1 100644
--- a/apps/platform-web/src/test/setup.ts
+++ b/apps/platform-web/src/test/setup.ts
@@ -22,6 +22,41 @@ if (typeof globalThis.window !== "undefined") {
         dispatchEvent: () => false,
       });
   }
+
+  // happy-dom's Storage implementation is not reliably restorable by
+  // `vi.restoreAllMocks()`: a `vi.spyOn(localStorage, "getItem")` installed in
+  // one test leaks its mock implementation into later tests in the same file
+  // (jsdom restores it fine). That silently broke tests that spy on getItem to
+  // simulate blocked storage and then rely on real reads afterwards. Replace
+  // localStorage with a standard in-memory Storage backed by a Map: it has
+  // honest get/set/remove/clear/key/length semantics AND, being a plain object
+  // with own configurable methods, spies on it are cleanly restored.
+  class MemoryStorage implements Storage {
+    #store = new Map<string, string>();
+    get length(): number {
+      return this.#store.size;
+    }
+    key(index: number): string | null {
+      return Array.from(this.#store.keys())[index] ?? null;
+    }
+    getItem(key: string): string | null {
+      return this.#store.has(key) ? this.#store.get(key)! : null;
+    }
+    setItem(key: string, value: string): void {
+      this.#store.set(key, String(value));
+    }
+    removeItem(key: string): void {
+      this.#store.delete(key);
+    }
+    clear(): void {
+      this.#store.clear();
+    }
+  }
+  Object.defineProperty(globalThis, "localStorage", {
+    value: new MemoryStorage(),
+    configurable: true,
+    writable: true,
+  });
 }
 
